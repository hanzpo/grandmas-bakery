{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grandmas-bakery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "getgrandma.com", "custom_domain": true },
    { "pattern": "www.getgrandma.com", "custom_domain": true }
  ],
  // The React SPA is served as static assets; only /api/* hits the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret config. Secrets (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, ELEVENLABS_TOOL_SECRET) go in .dev.vars locally and
  // `wrangler secret put` in prod.
  "vars": {
    "SUPABASE_URL": "https://lnubzikdbtywhhwiutjz.supabase.co"
  }
}
