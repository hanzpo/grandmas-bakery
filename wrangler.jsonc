{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grandmas-bakery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Keep the workers.dev URL alive alongside the custom domains: the Stripe webhook
  // and the ElevenLabs agent call it.
  "workers_dev": true,
  // Weekly newsletter (Cloudflare Email Service). getgrandma.com must be onboarded to Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "routes": [
    { "pattern": "getgrandma.com", "custom_domain": true },
    { "pattern": "www.getgrandma.com", "custom_domain": true }
  ],
  // The React SPA is served as static assets; only /api/* hits the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Non-secret config. Secrets (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, ELEVENLABS_TOOL_SECRET, UGC_PIPELINE_URL, UGC_PIPELINE_SECRET) go in .dev.vars locally and
  // `wrangler secret put` in prod.
  // ELEVENLABS_API_KEY is a secret via .dev.vars / wrangler secret put.
  "vars": {
    "SUPABASE_URL": "https://lnubzikdbtywhhwiutjz.supabase.co",
    "SUPPLY_AGENT_ID": "agent_2901m3zevbdqf219mym7q38rn1hh",
    "SUPPLY_PHONE_NUMBER_ID": "phnum_7301m3zfw2feemwt2pcmtenv11yr"
  }
}
